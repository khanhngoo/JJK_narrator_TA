# .env.example
# OpenAI API Key (required for text generation)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key (required for voice synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: JJK Narrator Voice IDs
# Use Instant Voice Clone (IVC) for development
ELEVENLABS_JJK_IVC_VOICE_ID=
# Use Professional Voice Clone (PVC) for production
ELEVENLABS_JJK_PVC_VOICE_ID=